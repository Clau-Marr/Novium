<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Novium — Billing built for interpreters</title>
<meta name="description" content="Novium turns your calendar into invoices automatically. Built for freelance language interpreters.">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --ink:#16130f;--ink2:#3a3630;--ink3:#706b63;--ink4:#a8a39b;
  --canvas:#f5f2ec;--canvas2:#ece8e0;--canvas3:#e0dbd0;
  --white:#ffffff;
  --teal:#1a7a6e;--teal2:#22a090;--teal-light:#e6f4f2;--teal-mid:#c0e8e3;
  --gold:#b8860b;--gold2:#d4a017;
  --r:10px;--r-sm:6px;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'Inter',sans-serif;background:var(--canvas);color:var(--ink);line-height:1.6;overflow-x:hidden;}
@media (prefers-reduced-motion: reduce){ *{animation:none!important;transition:none!important;} }

.hdr{padding:24px 40px;display:flex;align-items:center;justify-content:space-between;max-width:1100px;margin:0 auto;}
.logo{font-family:'Fraunces',serif;font-size:20px;color:var(--ink);letter-spacing:.01em;}
.hdr-note{font-size:12px;color:var(--ink3);letter-spacing:.08em;text-transform:uppercase;}

.hero{max-width:1100px;margin:0 auto;padding:60px 40px 40px;display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center;}
.eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:var(--teal);font-weight:600;margin-bottom:20px;}
.eyebrow::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--teal2);display:inline-block;animation:pulse 2s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}
h1{font-family:'Fraunces',serif;font-weight:300;font-size:52px;line-height:1.08;letter-spacing:-.01em;margin-bottom:22px;}
h1 em{font-style:italic;font-weight:400;color:var(--teal);}
.sub{font-size:17px;color:var(--ink2);max-width:460px;margin-bottom:36px;line-height:1.65;}

.cta-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:14px;}
.btn{display:inline-flex;align-items:center;gap:9px;padding:14px 26px;border-radius:var(--r-sm);font-family:'Inter',sans-serif;font-size:14px;font-weight:500;cursor:pointer;border:none;text-decoration:none;transition:all .18s;}
.btn-primary{background:var(--ink);color:white;}
.btn-primary:hover{background:#2a2620;transform:translateY(-1px);}
.cta-hint{font-size:12px;color:var(--ink4);}

/* Signature: calendar event flowing into an invoice line */
.demo{position:relative;height:360px;}
.demo-card{position:absolute;background:white;border-radius:12px;box-shadow:0 4px 24px rgba(22,19,15,.08),0 1px 2px rgba(22,19,15,.04);padding:18px 20px;border:1px solid var(--canvas3);}
.cal-card{top:10px;left:10px;width:250px;animation:calFloat 6s ease-in-out infinite;}
@keyframes calFloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
.cal-label{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink4);margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.cal-dot{width:6px;height:6px;border-radius:50%;background:#4285F4;}
.cal-title{font-family:'Fraunces',serif;font-size:16px;margin-bottom:4px;}
.cal-time{font-size:12px;color:var(--ink3);}

.flow-arrow{position:absolute;top:120px;left:200px;width:120px;height:80px;}
.flow-arrow svg{width:100%;height:100%;}
.flow-arrow path{stroke:var(--teal-mid);stroke-width:2;fill:none;stroke-dasharray:6 5;animation:dash 1.5s linear infinite;}
@keyframes dash{to{stroke-dashoffset:-22;}}

.inv-card{bottom:10px;right:0;width:290px;animation:invFloat 6s ease-in-out infinite 0.3s;}
@keyframes invFloat{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
.inv-hdr-mini{background:var(--ink);border-radius:8px 8px 0 0;margin:-18px -20px 14px;padding:12px 20px;}
.inv-hdr-mini .t{font-family:'Fraunces',serif;color:var(--teal2);font-size:13px;}
.inv-row{display:flex;justify-content:space-between;font-size:12px;padding:6px 0;border-bottom:1px solid var(--canvas);color:var(--ink2);}
.inv-total{display:flex;justify-content:space-between;font-weight:600;font-size:14px;padding-top:10px;color:var(--ink);}
.inv-total span:last-child{color:var(--teal);}
.check-badge{position:absolute;top:-10px;right:-10px;width:28px;height:28px;background:var(--teal2);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:14px;box-shadow:0 2px 8px rgba(26,122,110,.35);animation:pop 6s ease-in-out infinite 1s;}
@keyframes pop{0%,20%,100%{transform:scale(0);}25%,55%{transform:scale(1);}60%{transform:scale(0);}}

.features{max-width:1100px;margin:20px auto 0;padding:60px 40px;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--canvas3);border-radius:var(--r);overflow:hidden;}
.feature{background:var(--canvas);padding:28px 24px;}
.feature-num{font-family:'Fraunces',serif;font-style:italic;color:var(--teal-mid);font-size:13px;margin-bottom:14px;}
.feature h3{font-family:'Fraunces',serif;font-weight:400;font-size:17px;margin-bottom:8px;}
.feature p{font-size:13px;color:var(--ink3);line-height:1.6;}

.signoff{max-width:640px;margin:0 auto;padding:80px 40px 100px;text-align:center;}
.signoff h2{font-family:'Fraunces',serif;font-weight:300;font-size:28px;margin-bottom:14px;}
.signoff p{color:var(--ink3);font-size:14px;margin-bottom:28px;}

.ftr{border-top:1px solid var(--canvas3);padding:28px 40px;max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink4);}

@media(max-width:860px){
  .hero{grid-template-columns:1fr;padding-top:30px;gap:50px;}
  h1{font-size:38px;}
  .demo{height:300px;}
  .features{grid-template-columns:1fr 1fr;padding:40px 24px;}
  .hdr{padding:20px 24px;}
}
@media(max-width:520px){
  .features{grid-template-columns:1fr;}
  .demo{display:none;}
  h1{font-size:32px;}
}
</style>
</head>
<body>

<div class="hdr">
  <div class="logo">Novium</div>
  <div class="hdr-note">Launching August 2026</div>
</div>

<div class="hero">
  <div>
    <div class="eyebrow">Coming soon</div>
    <h1>Stop typing your<br>assignments <em>twice.</em></h1>
    <p class="sub">Novium reads your calendar and turns it straight into accurate, agency-ready invoices — rate cards, minimum-hour guarantees, and mileage included automatically. Built for freelance language interpreters, by one.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="mailto:masprofessionalservices.office@gmail.com?subject=Notify%20me%20when%20Novium%20launches&body=Hi%2C%20I%27d%20like%20to%20be%20notified%20when%20Novium%20launches.">
        Get notified at launch →
      </a>
    </div>
    <div class="cta-hint">No spam — just one email when it's ready.</div>
  </div>

  <div class="demo">
    <div class="demo-card cal-card">
      <div class="cal-label"><span class="cal-dot"></span>Google Calendar</div>
      <div class="cal-title">Boomerang Healthcare — Medical</div>
      <div class="cal-time">Tue · 2:00 PM–3:00 PM · Los Gatos</div>
    </div>
    <div class="flow-arrow">
      <svg viewBox="0 0 120 80"><path d="M5 15 Q 60 15 60 40 Q 60 65 115 65"/></svg>
    </div>
    <div class="demo-card inv-card">
      <div class="check-badge">✓</div>
      <div class="inv-hdr-mini"><span class="t">Invoice #MAS-2026-041</span></div>
      <div class="inv-row"><span>Medical — 1.0 hr</span><span>$70.00</span></div>
      <div class="inv-row"><span>Mileage — 12 mi</span><span>$8.04</span></div>
      <div class="inv-total"><span>Total due</span><span>$78.04</span></div>
    </div>
  </div>
</div>

<div class="features">
  <div class="feature">
    <div class="feature-num">Sync</div>
    <h3>Calendar → invoice</h3>
    <p>Connect your calendar once. Every assignment becomes a billable line automatically, no re-typing.</p>
  </div>
  <div class="feature">
    <div class="feature-num">Rates</div>
    <h3>Real agency terms</h3>
    <p>Per-client rates, minimum-hour guarantees, and mileage — billed the way your contracts actually work.</p>
  </div>
  <div class="feature">
    <div class="feature-num">Track</div>
    <h3>Know what's owed</h3>
    <p>Outstanding balances, partial payments, and monthly totals — always current, never a spreadsheet.</p>
  </div>
  <div class="feature">
    <div class="feature-num">Yours</div>
    <h3>Your data, your Drive</h3>
    <p>Everything lives in your browser and your own Google Drive. No one else's server holds your business.</p>
  </div>
</div>

<div class="signoff">
  <h2>Built while doing the work.</h2>
  <p>Novium started as one interpreter's own invoicing system — refined through real assignments, real agencies, and real payments before anyone else touched it.</p>
  <a class="btn btn-primary" href="mailto:masprofessionalservices.office@gmail.com?subject=Notify%20me%20when%20Novium%20launches&body=Hi%2C%20I%27d%20like%20to%20be%20notified%20when%20Novium%20launches.">
    Get notified at launch →
  </a>
</div>

<div class="ftr">
  <span>© 2026 Novium</span>
  <a href="privacy.html" style="color:var(--ink4);">Privacy Policy</a>
</div>

</body>
</html>
